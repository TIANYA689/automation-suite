  "routing_rules": [
    {
      "id": "R1",
      "when": ["写脚本", "开发脚本", "改脚本", "自动化脚本", "重构脚本"],
      "then": ["automation-architect"],
      "note": "先经架构师做需求分析与选型，再进叶子技能"
    },
    {
      "id": "R2",
      "when": ["har", "抓包", "curl"],
      "then": ["automation-architect"],
      "note": "先做 API 证据分析，再开发"
    },
    {
      "id": "R3",
      "when": ["加密", "混淆", "保护源码"],
      "then": ["python-obfuscator-pro", "js-script-obfuscator"],
      "note": "按语言二选一"
    },
    {
      "id": "R4",
      "when": ["解密", "还原", "脱壳", "解混淆"],
      "then": ["python-script-decryptor", "js-script-deobfuscator"],
      "note": "按语言二选一"
    },
    {
      "id": "R5",
      "when": ["沉淀", "固化", "同步技能"],
      "then": ["knowledge-architect"],
      "note": "仅用户明确要求时触发"
    },
    {
      "id": "R6",
      "when": ["符号恢复", "结构体", "反编译", "无符号"],
      "then": ["binary-symbol-recovery"],
      "note": "静态语义恢复；需要跑起来验证时再转 emulated-execution-debug"
    },
    {
      "id": "R7",
      "when": ["模拟执行", "unicorn", "跑通函数"],
      "then": ["emulated-execution-debug"],
      "note": "无设备条件下执行片段；静态定名不足时先转 binary-symbol-recovery"
    },
    {
      "id": "R8",
      "when": ["apk", "加固", "壳", "dex", "重打包", "签名校验", "归属判定"],
      "then": ["apk-reverse-analysis"],
      "note": "只做识别、度量与判定，不做绕过；需要符号级静态恢复时转 binary-symbol-recovery，需要跑片段时转 emulated-execution-debug"
    },
    {
      "id": "R9",
      "when": ["别人的脚本", "第三方脚本", "拆解", "值得复用", "对照重写"],
      "then": ["third-party-script-teardown"],
      "note": "只读拆解与复用分档，不执行目标脚本；代码不可读时先转对应解密技能，需要固化时转 knowledge-architect"
    }
  ],
  "execution": {
    "enabled": true,
    "default_dry_run": true,
    "allowlist": [],
    "timeout_seconds": 120,
    "max_output_chars": 8000,
    "audit_log": "exports/automation/module-audit.jsonl",
    "note": "allowlist 为空表示任何模块都不可执行。启用某个模块需在此显式列出其名称，然后重建索引。默认 dry_run=true，只解析命令不执行。"
  }
}
